# Build output
/bin/

# Real WebExtensions used for local validation (not vendored — ADR 0010)
/extensions/

# Editor / OS cruft
*.swp
.DS_Store

# Claude Code session tooling
/.claude/

# Go test artifacts
*.out
*.test

# WPT conformance harness run output (regenerated by `make wpt`)
/wpt/last-run.json

# Vendored web-platform-tests corpus — NOT committed (48M+). Fetched on demand by
# `make wpt-sync` at the pinned SHA. Only WPT_VERSION (the pin) is tracked, so a
# fresh clone can reproduce the exact corpus.
/testdata/wpt/*
!/testdata/wpt/WPT_VERSION

# membench run artifacts (Playwright MCP writes snapshot files beside its cwd;
# `go build` in the nested module drops a binary)
/scripts/membench/.playwright-mcp/
/scripts/membench/membench
