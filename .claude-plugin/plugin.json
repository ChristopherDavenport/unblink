{
  "name": "unblink",
  "description": "Pure-Go MCP server that turns any web page into clean, token-budgeted Markdown for AI agents — no Chromium, no V8, no Node.",
  "version": "0.24.0",
  "author": {
    "name": "Christopher Davenport"
  },
  "homepage": "https://github.com/ChristopherDavenport/unblink",
  "repository": "https://github.com/ChristopherDavenport/unblink",
  "license": "MIT",
  "keywords": [
    "mcp",
    "browser",
    "web",
    "markdown",
    "javascript",
    "go"
  ],
  "mcpServers": {
    "unblink": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "ghcr.io/christopherdavenport/unblink:0.24.0"
      ]
    }
  }
}
